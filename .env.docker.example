# Optional overrides for `docker compose --env-file .env.docker up --build`.
# `docker compose up --build` works without this file by using safe local defaults.
COMPOSE_PROJECT_NAME=limitless-architecting-os

WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

POSTGRES_USER=limitless
POSTGRES_PASSWORD=limitless
POSTGRES_DB=limitless
MINIO_ROOT_USER=limitless
MINIO_ROOT_PASSWORD=limitless-dev-secret
OBJECT_STORAGE_BUCKET=limitless-evidence

# The UI remains fixture-backed until the Prisma repository wiring slice is completed.
DATA_MODE=fixture
NEXT_PUBLIC_DATA_MODE=fixture
WORKER_MODE=redis
AI_PROVIDER_MODE=mock
AI_WRITEBACK_ENABLED=false
AI_MAX_OUTPUT_TOKENS=1800

# Optional provider credentials. Never commit a populated .env.docker.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=
