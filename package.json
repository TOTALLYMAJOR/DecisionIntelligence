{
  "name": "limitless-architecting-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-grounded architecting intelligence workbench and prompt compiler.",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "dev": "npm run dev -w @limitless/web",
    "dev:web": "npm run dev -w @limitless/web",
    "dev:worker": "npm run dev -w @limitless/worker",
    "dev:full": "concurrently --kill-others-on-fail -n web,worker -c cyan,magenta \"npm run dev:web\" \"npm run dev:worker\"",
    "build": "npm run db:generate && npm run build -w @limitless/web",
    "start": "npm run start -w @limitless/web",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "bash scripts/verify.sh",
    "verify:structure": "node scripts/verify-structure.mjs",
    "infra:up": "docker compose up -d postgres redis minio",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f --tail=100",
    "db:generate": "npm run prisma:generate -w @limitless/db",
    "db:migrate": "npm run prisma:migrate -w @limitless/db",
    "db:migrate:deploy": "npm run prisma:migrate:deploy -w @limitless/db",
    "db:seed": "npm run seed -w @limitless/db",
    "db:studio": "npm run prisma:studio -w @limitless/db",
    "ingest": "npm run ingest -w @limitless/ingestion",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "docker:up": "docker compose up --build -d",
    "docker:run": "docker compose up --build",
    "docker:down": "docker compose down --remove-orphans",
    "docker:logs": "docker compose logs -f --tail=150",
    "docker:ps": "docker compose ps",
    "docker:verify": "bash scripts/docker-verify.sh",
    "docker:reset": "bash scripts/docker-reset.sh",
    "db:push": "npm run prisma:push -w @limitless/db",
    "check:docker": "node scripts/check-docker-contract.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.11",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "7.3.6",
    "vitest": "^4.1.7"
  }
}
