# Runtime mode: fixture works with no external services.
DATA_MODE=fixture
NEXT_PUBLIC_DATA_MODE=fixture
APP_URL=http://localhost:3000

# PostgreSQL / Prisma
DATABASE_URL=postgresql://limitless:limitless@localhost:5432/limitless?schema=public
DIRECT_URL=postgresql://limitless:limitless@localhost:5432/limitless?schema=public

# Redis / BullMQ
WORKER_MODE=fixture
REDIS_URL=redis://localhost:6379

# Local S3-compatible evidence vault (MinIO)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=limitless-evidence
OBJECT_STORAGE_ACCESS_KEY=limitless
OBJECT_STORAGE_SECRET_KEY=limitless-dev-secret
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# AI provider routing: mock | openai | anthropic | dual
AI_PROVIDER_MODE=mock
AI_WRITEBACK_ENABLED=false
AI_MAX_OUTPUT_TOKENS=1800

# OpenAI Responses API + embeddings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=

# Anthropic Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=

# Private access scaffold. Local mode stays open until GitHub OAuth is wired.
AUTH_MODE=local
DEV_OWNER_EMAIL=major.mike@local.test
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_ALLOWED_GITHUB_LOGINS=TOTALLYMAJOR
